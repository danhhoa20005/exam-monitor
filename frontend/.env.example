# Public backend base URL, without a trailing slash.
# Example: https://visionguard-ai-backend.onrender.com
VITE_API_BASE_URL=

# Optional direct WebSocket base URL. If omitted, it is derived from VITE_API_BASE_URL.
# Example: wss://visionguard-ai-backend.onrender.com
VITE_WS_URL=

# Enable Mock simulation for testing without backend
VITE_USE_MOCK=true
